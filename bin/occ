#!/usr/bin/env bash
#
# bashsupport disable=BP5007
#
# index:
#   - this::help
#   - this::init_aks
#   - this::init_generic
#   - this::init_ocp
#   - this::init_oke
#   - this::occ_yaml_get
#   - this::occ_yaml_get_alias_field
#   - this::print_empty_kubeconfig
#   - this::session_is_valid
#   - this::set_context_extension_aptakube
#   - this::set_context_namespace
#   - this::use_context
#

#######################################
# No description.
# Arguments:
#   1 - exit_code (optional, integer)
# Outputs:
#   Help message to stdout.
#######################################
this::help() {
  local exit_code
  exit_code="${1:-1}"
  cat << EOT

  Usage: ${0} [OPTION...] <ALIAS>

  Options:
    -f             Force login even if the current session is valid
    -l             List available aliases and exit
    -n <namespace> Set the specified namespace
    -r             Restore default kubeconfig files and exit
    -t <token>     Set the specified token
    -u             Unset current context and exit

  Help options:
    -H Show this help message
    -U Display brief usage
    -V Print version

  Configuration file example:
    [...]
    aliases:
      <aks alias>:
        aks_admin: false
        aks_name: <aks name>
        aks_resource_group: <aks resource group>
        aks_subscription: <aks subscription>
        cluster_and_context_name: <cluster and context name>
        extension_aptakube_order: 1
        extension_aptakube_tags: AKS,aks-label-1,aks-label-2
        kind: aks
        kubeconfig: /Users/jobace78/.kubeconfig-aks1.yaml
        user_name: <mail or user name>
      <generic alias>:
        cluster_and_context_name: <cluster and context name>
        extension_aptakube_icon_url: /Users/jobace78/icon_kubernetes_512x512.png
        extension_aptakube_order: 2
        extension_aptakube_tags: GENERIC,generic-label-1,generic-label-2
        generic_server: https://<api address>
        kind: generic
        kubeconfig: /Users/jobace78/.kubeconfig-generic1.yaml
        user_name: <mail or user name>
      <manual alias>:
        cluster_and_context_name: <cluster and context name>
        kind: manual
        kubeconfig: /Users/jobace78/.kubeconfig-manual1.yaml
      <ocp alias>:
        cluster_and_context_name: <cluster and context name>
        extension_aptakube_icon_url: /Users/jobace78/icon_openshift_512x512.png
        extension_aptakube_order: 3
        extension_aptakube_tags: OCP,ocp-label-1,ocp-label-2
        kind: ocp
        kubeconfig: /Users/jobace78/.kubeconfig-ocp1.yaml
        ocp_server: https://<api address>
        user_name: <mail or user name>
      <oke alias>:
        cluster_and_context_name: <cluster and context name>
        extension_aptakube_order: 4
        extension_aptakube_tags: OKE,oke-label-1,oke-label-2
        kind: oke
        kubeconfig: /Users/jobace78/.kubeconfig-oke1.yaml
        oke_cluster_id: <oke cluster id>
        oke_profile: <oke profile>
        user_name: <mail or user name>
    [...]

  Environment variable example:
    [...]
    KUBECONFIG=":\${HOME:?}/.kube/config"
    KUBECONFIG="\${KUBECONFIG}:/Users/jobace78/.kubeconfig-aks1.yaml"
    KUBECONFIG="\${KUBECONFIG}:/Users/jobace78/.kubeconfig-generic1.yaml"
    KUBECONFIG="\${KUBECONFIG}:/Users/jobace78/.kubeconfig-manual1.yaml"
    KUBECONFIG="\${KUBECONFIG}:/Users/jobace78/.kubeconfig-ocp1.yaml"
    KUBECONFIG="\${KUBECONFIG}:/Users/jobace78/.kubeconfig-oke1.yaml"
    [...]

EOT
  functions::exit "${exit_code}"
}

#######################################
# No description.
# Arguments:
#   1: local_current_aks_admin (required, string)
#   2: local_current_aks_name (required, string)
#   3: local_current_aks_resource_group (required, string)
#   4: local_current_aks_subscription (required, string)
#   5: local_current_cluster_and_context_name (required, string)
#   6: local_current_kubeconfig (required, string)
#   7: local_current_user_name (required, string)
#######################################
this::init_aks() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_aks_admin
  local local_current_aks_name
  local local_current_aks_resource_group
  local local_current_aks_subscription
  local local_current_cluster_and_context_name
  local local_current_kubeconfig
  local local_current_user_name
  local_current_aks_admin="${1:?}"
  local_current_aks_name="${2:?}"
  local_current_aks_resource_group="${3:?}"
  local_current_aks_subscription="${4:?}"
  local_current_cluster_and_context_name="${5:?}"
  local_current_kubeconfig="${6:?}"
  local_current_user_name="${7:?}"
  # truncate any existing kubeconfig...
  #
  if [ -f "${local_current_kubeconfig}" ]; then
    cat /dev/null > "${local_current_kubeconfig}"
  fi
  if [ "${local_current_aks_admin}" = 'true' ]; then
    az aks get-credentials \
      --admin \
      --context "${local_current_aks_name}" \
      --file "${local_current_kubeconfig}" \
      --name "${local_current_aks_name}" \
      --resource-group "${local_current_aks_resource_group}" \
      --subscription "${local_current_aks_subscription}" 1> /dev/null
  else
    az aks get-credentials \
      --context "${local_current_aks_name}" \
      --file "${local_current_kubeconfig}" \
      --name "${local_current_aks_name}" \
      --resource-group "${local_current_aks_resource_group}" \
      --subscription "${local_current_aks_subscription}" 1> /dev/null
  fi
  yq --inplace \
    "
    .clusters[].name = \"${local_current_cluster_and_context_name}\"
    | .contexts[].context |= {\"cluster\": \"${local_current_cluster_and_context_name}\", \"namespace\": (.namespace // \"default\"), \"user\": \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"}
    | .contexts[].name = \"${local_current_cluster_and_context_name}\"
    | del(.current-context)
    | .users[].name = \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"
    " \
    "${local_current_kubeconfig}"
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_generic_server (required, string)
#   3: local_current_kubeconfig (required, string)
#   4: local_current_token (required, string)
#   5: local_current_user_name (required, string)
#######################################
this::init_generic() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_generic_server
  local local_current_kubeconfig
  local local_current_token
  local local_current_user_name
  local_current_cluster_and_context_name="${1:?}"
  local_current_generic_server="${2:?}"
  local_current_kubeconfig="${3:?}"
  local_current_token="${4:?}"
  local_current_user_name="${5:?}"
  oc config set-cluster \
    --kubeconfig="${local_current_kubeconfig}" \
    --server="${local_current_generic_server}" \
    "${local_current_cluster_and_context_name}" 1> /dev/null
  oc config set-context \
    --cluster="${local_current_cluster_and_context_name}" \
    --kubeconfig="${local_current_kubeconfig}" \
    --user="${local_current_user_name}-at-${local_current_cluster_and_context_name}" \
    "${local_current_cluster_and_context_name}" 1> /dev/null
  if [ "${local_current_token}" != 'changeme' ]; then
    oc config set-credentials \
      --kubeconfig="${local_current_kubeconfig}" \
      --token="${local_current_token}" \
      "${local_current_user_name}-at-${local_current_cluster_and_context_name}" 1> /dev/null
  fi
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_kubeconfig (required, string)
#   3: local_current_ocp_server (required, string)
#   4: local_current_user_name (required, string)
#######################################
this::init_ocp() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_kubeconfig
  local local_current_ocp_server
  local local_current_user_name
  local_current_cluster_and_context_name="${1:?}"
  local_current_kubeconfig="${2:?}"
  local_current_ocp_server="${3:?}"
  local_current_user_name="${4:?}"
  # truncate any existing kubeconfig...
  #
  if [ -f "${local_current_kubeconfig}" ]; then
    cat /dev/null > "${local_current_kubeconfig}"
  fi
  oc login "${local_current_ocp_server}" \
    --kubeconfig="${local_current_kubeconfig}" \
    --web 1> /dev/null
  yq --inplace \
    "
    .clusters[].name = \"${local_current_cluster_and_context_name}\"
    | .contexts[].context |= {\"cluster\": \"${local_current_cluster_and_context_name}\", \"namespace\": (.namespace // \"default\"), \"user\": \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"}
    | .contexts[].name = \"${local_current_cluster_and_context_name}\"
    | del(.current-context)
    | .users[].name = \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"
    " \
    "${local_current_kubeconfig}"
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_kubeconfig (required, string)
#   3: local_current_oke_cluster_id (required, string)
#   4: local_current_oke_profile (required, string)
#   5: local_current_user_name (required, string)
#######################################
this::init_oke() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_kubeconfig
  local local_current_oke_cluster_id
  local local_current_oke_profile
  local local_current_user_name
  local_current_cluster_and_context_name="${1:?}"
  local_current_kubeconfig="${2:?}"
  local_current_oke_cluster_id="${3:?}"
  local_current_oke_profile="${4:?}"
  local_current_user_name="${5:?}"
  # truncate any existing kubeconfig...
  #
  if [ -f "${local_current_kubeconfig}" ]; then
    cat /dev/null > "${local_current_kubeconfig}"
  fi
  oci --profile "${local_current_oke_profile}" ce cluster create-kubeconfig \
    --cluster-id "${local_current_oke_cluster_id}" \
    --file "${local_current_kubeconfig}"
  yq --inplace \
    "
    .clusters[].name = \"${local_current_cluster_and_context_name}\"
    | .contexts[].context |= {\"cluster\": \"${local_current_cluster_and_context_name}\", \"namespace\": (.namespace // \"default\"), \"user\": \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"}
    | .contexts[].name = \"${local_current_cluster_and_context_name}\"
    | del(.current-context)
    | .kind = null
    | .kind = \"Config\"
    | .users[].name = \"${local_current_user_name}-at-${local_current_cluster_and_context_name}\"
    | .users[].user.exec.args = [\"--profile\", \"${local_current_oke_profile}\"] + .users[].user.exec.args
    " \
    "${local_current_kubeconfig}"
}

#######################################
# No description.
# Globals:
#   occ_yaml
# Arguments:
#   1: local_current_expression (required, string)
# Outputs:
#   The yq query result against the config.
#######################################
this::occ_yaml_get() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_expression
  local_current_expression="${1:?}"
  yq "${local_current_expression}" "${occ_yaml:?}" 2> /dev/null
}

#######################################
# No description.
# Globals:
#   occ_yaml
# Arguments:
#   1: local_current_alias (required, string)
#   2: local_current_field (required, string)
# Outputs:
#   The yq query result against the config.
#######################################
this::occ_yaml_get_alias_field() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_alias
  local local_current_field
  local_current_alias="${1:?}"
  local_current_field="${2:?}"
  yq ".aliases.${local_current_alias}.${local_current_field} | select(. != null)" "${occ_yaml:?}" 2> /dev/null
}

#######################################
# No description.
# Arguments:
#   1: path (required, string)
#######################################
this::print_empty_kubeconfig() {
  local path
  path="${1:?}"
  [ -d "$(dirname "${path}")" ] || mkdir -p "$(dirname "${path}")"
  cat << 'EOT' > "${path}"
apiVersion: v1
clusters: null
contexts: null
kind: Config
preferences: {}
users: null
EOT
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_kubeconfig (required, string)
# Returns:
#   0 ...
#   1 ...
#######################################
this::session_is_valid() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_kubeconfig
  local_current_cluster_and_context_name="${1:?}"
  local_current_kubeconfig="${2:?}"
  if oc --context="${local_current_cluster_and_context_name}" --kubeconfig="${local_current_kubeconfig}" whoami 1> /dev/null 2> /dev/null && [[ $(oc --context="${local_current_cluster_and_context_name}" --kubeconfig="${local_current_kubeconfig}" whoami 2> /dev/null) != 'system:anonymous' ]]; then
    return 0
  else
    return 1
  fi
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_extension_aptakube_icon_url (required, string)
#   3: local_current_extension_aptakube_order (required, string)
#   4: local_current_extension_aptakube_tags (required, string)
#   5: local_current_kubeconfig (required, string)
#######################################
this::set_context_extension_aptakube() {
  local tag_index
  tag_index=''
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_extension_aptakube_icon_url
  local local_current_extension_aptakube_order
  local local_current_extension_aptakube_tags
  local local_current_extension_aptakube_tags_array
  local local_current_kubeconfig
  local_current_cluster_and_context_name="${1:?}"
  local_current_extension_aptakube_icon_url="${2:-}"
  local_current_extension_aptakube_order="${3:-}"
  local_current_extension_aptakube_tags="${4:-}"
  local_current_extension_aptakube_tags_array=()
  local_current_kubeconfig="${5:?}"
  yq --inplace \
    "(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].name) = \"aptakube\"" \
    "${local_current_kubeconfig}"
  # extension_aptakube_icon_url
  #
  yq --inplace \
    "del(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.icon-url)" \
    "${local_current_kubeconfig}"
  if [ -n "${local_current_extension_aptakube_icon_url}" ]; then
    yq --inplace \
      "(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.icon-url) = \"${local_current_extension_aptakube_icon_url}\"" \
      "${local_current_kubeconfig}"
  fi
  # extension_aptakube_order
  #
  yq --inplace \
    "del(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.order)" \
    "${local_current_kubeconfig}"
  if [ -n "${local_current_extension_aptakube_order}" ]; then
    yq --inplace \
      "(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.order) = ${local_current_extension_aptakube_order}" \
      "${local_current_kubeconfig}"
  fi
  # extension_aptakube_tags
  #
  yq --inplace \
    "del(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.tags)" \
    "${local_current_kubeconfig}"
  if [ -n "${local_current_extension_aptakube_tags}" ]; then
    IFS=',' read -a local_current_extension_aptakube_tags_array -r <<< "${local_current_extension_aptakube_tags}"
    for tag_index in "${!local_current_extension_aptakube_tags_array[@]}"; do
      yq --inplace \
        "(.contexts[].context | select(.cluster == \"${local_current_cluster_and_context_name}\") | .extensions[0].extension.tags[${tag_index}]) = \"${local_current_extension_aptakube_tags_array[tag_index]}\"" \
        "${local_current_kubeconfig}"
    done
  fi
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#   2: local_current_kubeconfig (required, string)
#   3: local_current_namespace (required, string)
#######################################
this::set_context_namespace() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local local_current_kubeconfig
  local local_current_namespace
  local_current_cluster_and_context_name="${1:?}"
  local_current_kubeconfig="${2:?}"
  local_current_namespace="${3:?}"
  oc config set-context \
    --kubeconfig="${local_current_kubeconfig}" \
    --namespace="${local_current_namespace}" \
    "${local_current_cluster_and_context_name}" 1> /dev/null
}

#######################################
# No description.
# Arguments:
#   1: local_current_cluster_and_context_name (required, string)
#######################################
this::use_context() {
  # INFO : local variables with "local" prefix to avoid "collisions"...
  local local_current_cluster_and_context_name
  local_current_cluster_and_context_name="${1:?}"
  oc config use-context \
    "${local_current_cluster_and_context_name}"
}

#######################################
# No description.
# Globals:
#   HOME
#   OCC_YAML
#   OPTARG
#   OPTIND
# Arguments:
#   None
#######################################
main() {
  if [ -f "$(dirname "${0}")"/../etc/bash44.shconf ]; then
    # shellcheck source=../etc/bash44.shconf
    . "$(dirname "${0}")"/../etc/bash44.shconf || exit 1
  else
    # shellcheck source=/dev/null
    . "${HOME:?}"/.etc/bash44.shconf || exit 1
  fi
  if [ -f "$(dirname "${0}")"/../etc/constants.shconf ]; then
    # shellcheck source=../etc/constants.shconf
    . "$(dirname "${0}")"/../etc/constants.shconf
  else
    # shellcheck source=/dev/null
    . "${HOME:?}"/.etc/constants.shconf
  fi
  if [ -f "$(dirname "${0}")"/../etc/functions.shconf ]; then
    # shellcheck source=../etc/functions.shconf
    . "$(dirname "${0}")"/../etc/functions.shconf
  else
    # shellcheck source=/dev/null
    . "${HOME:?}"/.etc/functions.shconf
  fi
  # local variables
  #
  local current_aks_admin
  local current_aks_name
  local current_aks_resource_group
  local current_aks_subscription
  local current_cluster_and_context_name
  local current_extension_aptakube_icon_url
  local current_extension_aptakube_order
  local current_extension_aptakube_tags
  local current_force
  local current_generic_server
  local current_kind
  local current_kubeconfig
  local current_namespace
  local current_ocp_server
  local current_oke_cluster_id
  local current_oke_profile
  local current_token
  local current_user_name
  local default_force
  local default_namespace
  local default_token
  local getopts_alias
  local getopts_aliases
  local getopts_args
  local getopts_kubeconfig
  local getopts_response
  local getopts_version
  local occ_yaml
  local sed
  current_aks_admin=''
  current_aks_name=''
  current_aks_resource_group=''
  current_aks_subscription=''
  current_cluster_and_context_name=''
  current_extension_aptakube_icon_url=''
  current_extension_aptakube_order=''
  current_extension_aptakube_tags=''
  current_force=''
  current_generic_server=''
  current_kind=''
  current_kubeconfig=''
  current_namespace=''
  current_ocp_server=''
  current_oke_cluster_id=''
  current_oke_profile=''
  current_token=''
  current_user_name=''
  default_force='false'
  default_namespace='default'
  default_token='changeme'
  getopts_alias=''
  getopts_aliases=()
  getopts_args=''
  getopts_kubeconfig=''
  getopts_response=''
  getopts_version='v20260629'
  occ_yaml="${OCC_YAML:-"${HOME:?}"/.occ.yaml}"
  sed='sed'
  trap 'functions::catch_all ${?}' ERR SIGHUP SIGINT SIGQUIT SIGTERM
  # setup
  #
  case "$(uname)" in
    Darwin*)
      sed='gsed'
      ;;
  esac
  mkdir -p "${HOME:?}"/.kube
  touch "${HOME:?}"/.kube/config 1> /dev/null
  # getopts_args / getopts_version
  #
  OPTIND=1
  while getopts 'fln:rt:uHUV' getopts_args; do
    case "${getopts_args}" in
      f)
        current_force='true'
        ;;
      l)
        if [ -f "${occ_yaml}" ]; then
          while read -r getopts_alias; do
            getopts_aliases+=("${getopts_alias}")
          done < <(this::occ_yaml_get '.aliases | keys | sort | .[]')
          if [[ "${getopts_aliases[*]}" ]]; then
            functions::stdout "${getopts_aliases[*]}"
            functions::exit 0
          else
            functions::exit 1 "is '${occ_yaml}' empty ???"
          fi
        else
          functions::exit 1 "'${occ_yaml}' was NOT found, exiting."
        fi
        ;;
      n)
        current_namespace="${OPTARG}"
        ;;
      r)
        if [ -f "${occ_yaml}" ]; then
          while read -r getopts_kubeconfig; do
            if [ -f "${getopts_kubeconfig}" ]; then
              read -p "Do you want to restore [${getopts_kubeconfig}]? (y/N) " -r getopts_response < /dev/tty
              case "${getopts_response}" in
                Y | y)
                  this::print_empty_kubeconfig "${getopts_kubeconfig}"
                  ;;
                *)
                  functions::stdout 'skipped, continuing.'
                  ;;
              esac
            fi
          done < <(this::occ_yaml_get '[ .aliases[].kubeconfig | select(. != null) ] | sort | unique | .[]')
        fi
        read -p "Do you want to restore [${HOME:?}/.kube/config]? (Y/n) " -r getopts_response < /dev/tty
        case "${getopts_response}" in
          N | n)
            functions::stdout 'skipped, continuing.'
            ;;
          *)
            this::print_empty_kubeconfig "${HOME:?}"/.kube/config
            ;;
        esac
        functions::exit 0
        ;;
      t)
        current_token="${OPTARG}"
        ;;
      u)
        if [ -f "${occ_yaml}" ]; then
          while read -r getopts_kubeconfig; do
            if [ -f "${getopts_kubeconfig}" ]; then
              ${sed} -i '/^current-context:/d' "${getopts_kubeconfig}"
            fi
          done < <(this::occ_yaml_get '[ .aliases[].kubeconfig | select(. != null) ] | sort | unique | .[]')
        fi
        ${sed} -i '/^current-context:/d' "${HOME:?}"/.kube/config
        functions::exit 0
        ;;
      H | U)
        this::help 0
        ;;
      V)
        functions::exit 0 "${getopts_version}"
        ;;
      ?)
        this::help 1
        ;;
    esac
  done
  shift $((OPTIND - 1))
  # main
  #
  [ $# -ge 1 ] || this::help 1
  getopts_alias="${1:?}"
  if [ -f "${occ_yaml}" ]; then
    # common variables
    #
    current_cluster_and_context_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" cluster_and_context_name)"
    current_extension_aptakube_icon_url="$(this::occ_yaml_get_alias_field "${getopts_alias}" extension_aptakube_icon_url)"
    current_extension_aptakube_order="$(this::occ_yaml_get_alias_field "${getopts_alias}" extension_aptakube_order)"
    current_extension_aptakube_tags="$(this::occ_yaml_get_alias_field "${getopts_alias}" extension_aptakube_tags)"
    current_kind="$(this::occ_yaml_get_alias_field "${getopts_alias}" kind)"
    current_kubeconfig="$(this::occ_yaml_get_alias_field "${getopts_alias}" kubeconfig)"
    case "${current_kind:?}" in
      aks)
        # aks variables
        #
        current_aks_admin="$(this::occ_yaml_get_alias_field "${getopts_alias}" aks_admin)"
        current_aks_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" aks_name)"
        current_aks_resource_group="$(this::occ_yaml_get_alias_field "${getopts_alias}" aks_resource_group)"
        current_aks_subscription="$(this::occ_yaml_get_alias_field "${getopts_alias}" aks_subscription)"
        current_user_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" user_name)"
        # aks
        #
        if [ "${current_force:-${default_force}}" = 'true' ] || ! this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}"; then
          this::init_aks \
            "${current_aks_admin:?}" \
            "${current_aks_name:?}" \
            "${current_aks_resource_group:?}" \
            "${current_aks_subscription:?}" \
            "${current_cluster_and_context_name:?}" \
            "${current_kubeconfig:?}" \
            "${current_user_name:?}"
          this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}" || functions::exit 1 "NOT AUTHENTICATED"
        fi
        this::set_context_namespace \
          "${current_cluster_and_context_name:?}" \
          "${current_kubeconfig:?}" \
          "${current_namespace:-${default_namespace}}"
        this::use_context \
          "${current_cluster_and_context_name:?}"
        this::set_context_extension_aptakube \
          "${current_cluster_and_context_name:?}" \
          "${current_extension_aptakube_icon_url:-}" \
          "${current_extension_aptakube_order:-}" \
          "${current_extension_aptakube_tags:-}" \
          "${current_kubeconfig:?}"
        ;;
      generic)
        # generic variables
        #
        current_generic_server="$(this::occ_yaml_get_alias_field "${getopts_alias}" generic_server)"
        current_user_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" user_name)"
        # generic
        #
        if [ "${current_force:-${default_force}}" = 'true' ] || ! this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}"; then
          this::init_generic \
            "${current_cluster_and_context_name:?}" \
            "${current_generic_server:?}" \
            "${current_kubeconfig:?}" \
            "${current_token:-${default_token}}" \
            "${current_user_name:?}"
          this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}" || functions::exit 1 "NOT AUTHENTICATED"
        fi
        this::set_context_namespace \
          "${current_cluster_and_context_name:?}" \
          "${current_kubeconfig:?}" \
          "${current_namespace:-${default_namespace}}"
        this::use_context \
          "${current_cluster_and_context_name:?}"
        this::set_context_extension_aptakube \
          "${current_cluster_and_context_name:?}" \
          "${current_extension_aptakube_icon_url:-}" \
          "${current_extension_aptakube_order:-}" \
          "${current_extension_aptakube_tags:-}" \
          "${current_kubeconfig:?}"
        ;;
      manual)
        # manual
        #
        this::set_context_namespace \
          "${current_cluster_and_context_name:?}" \
          "${current_kubeconfig:?}" \
          "${current_namespace:-${default_namespace}}"
        this::use_context \
          "${current_cluster_and_context_name:?}"
        ;;
      ocp)
        # ocp variables
        #
        current_ocp_server="$(this::occ_yaml_get_alias_field "${getopts_alias}" ocp_server)"
        current_user_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" user_name)"
        # ocp
        #
        if [ "${current_force:-${default_force}}" = 'true' ] || ! this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}"; then
          this::init_ocp \
            "${current_cluster_and_context_name:?}" \
            "${current_kubeconfig:?}" \
            "${current_ocp_server:?}" \
            "${current_user_name:?}"
          this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}" || functions::exit 1 "NOT AUTHENTICATED"
        fi
        this::set_context_namespace \
          "${current_cluster_and_context_name:?}" \
          "${current_kubeconfig:?}" \
          "${current_namespace:-${default_namespace}}"
        this::use_context \
          "${current_cluster_and_context_name:?}"
        this::set_context_extension_aptakube \
          "${current_cluster_and_context_name:?}" \
          "${current_extension_aptakube_icon_url:-}" \
          "${current_extension_aptakube_order:-}" \
          "${current_extension_aptakube_tags:-}" \
          "${current_kubeconfig:?}"
        ;;
      oke)
        # oke variables
        #
        current_oke_cluster_id="$(this::occ_yaml_get_alias_field "${getopts_alias}" oke_cluster_id)"
        current_oke_profile="$(this::occ_yaml_get_alias_field "${getopts_alias}" oke_profile)"
        current_user_name="$(this::occ_yaml_get_alias_field "${getopts_alias}" user_name)"
        # oke
        #
        if [ "${current_force:-${default_force}}" = 'true' ] || ! this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}"; then
          this::init_oke \
            "${current_cluster_and_context_name:?}" \
            "${current_kubeconfig:?}" \
            "${current_oke_cluster_id:?}" \
            "${current_oke_profile:?}" \
            "${current_user_name:?}"
          this::session_is_valid "${current_cluster_and_context_name:?}" "${current_kubeconfig:?}" || functions::exit 1 "NOT AUTHENTICATED"
        fi
        this::set_context_namespace \
          "${current_cluster_and_context_name:?}" \
          "${current_kubeconfig:?}" \
          "${current_namespace:-${default_namespace}}"
        this::use_context \
          "${current_cluster_and_context_name:?}"
        this::set_context_extension_aptakube \
          "${current_cluster_and_context_name:?}" \
          "${current_extension_aptakube_icon_url:-}" \
          "${current_extension_aptakube_order:-}" \
          "${current_extension_aptakube_tags:-}" \
          "${current_kubeconfig:?}"
        ;;
      *)
        functions::exit 1 'Unsupported kind, exiting.'
        ;;
    esac
  else
    functions::exit 1 "'${occ_yaml}' was NOT found, exiting."
  fi
}

# bashsupport disable=BP5001
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  main "${@}"
fi
