#!/usr/bin/env bash

#
# Notes:
#   - deprecated, run shellcheck directly and keep these options in ~/.shellcheckrc
#

# shellcheck source=../etc/bash44.shconf
. "$(dirname "${0}")"/../etc/bash44.shconf || exit 1
# shellcheck source=../etc/constants.shconf
. "$(dirname "${0}")"/../etc/constants.shconf
# shellcheck source=../etc/functions.shconf
. "$(dirname "${0}")"/../etc/functions.shconf

if [ -x "${HOMEBREW_ROOT:-"$(brew --prefix 2> /dev/null)"}"/bin/shellcheck ]; then
  shellcheck_path="${HOMEBREW_ROOT:-"$(brew --prefix 2> /dev/null)"}"/bin/shellcheck
else
  shellcheck_path=shellcheck
fi

# shellcheck disable=SC2048
# shellcheck disable=SC2086
"${shellcheck_path}" \
  --enable=add-default-case,avoid-negated-conditions,avoid-nullary-conditions,check-set-e-suppressed,check-unassigned-uppercase,deprecate-which,quote-safe-variables,require-variable-braces,useless-use-of-cat \
  --external-sources \
  --source-path=SCRIPTDIR \
  ${*}
