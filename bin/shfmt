#!/usr/bin/env bash

#
# Notes:
#   - deprecated, run shfmt directly and keep these options in .editorconfig
#

# shellcheck source=../etc/bash44.shconf
. "$(dirname "${0}")"/../etc/bash44.shconf || exit 1
# shellcheck source=../etc/constants.shconf
. "$(dirname "${0}")"/../etc/constants.shconf
# shellcheck source=../etc/functions.shconf
. "$(dirname "${0}")"/../etc/functions.shconf

if [ -x "$(mise which shfmt 2> /dev/null)" ]; then
  shfmt_path="$(mise which shfmt 2> /dev/null)"
elif [ -x "${HOMEBREW_ROOT:-"$(brew --prefix 2> /dev/null)"}"/bin/shfmt ]; then
  shfmt_path="${HOMEBREW_ROOT:-"$(brew --prefix 2> /dev/null)"}"/bin/shfmt
else
  shfmt_path=shfmt
fi

# shellcheck disable=SC2048
# shellcheck disable=SC2086
"${shfmt_path}" \
  --binary-next-line \
  --case-indent \
  --indent=2 \
  --space-redirects \
  ${*}
