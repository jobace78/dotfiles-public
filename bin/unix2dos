#!/usr/bin/env bash

#######################################
# Print the usage help message and exit with the given exit code.
# Arguments:
#   1 - exit code (optional, integer)
# Outputs:
#   Help message to stdout.
# Returns:
#   None
#######################################
this::help() {
  local exit_code
  exit_code="${1:-1}"
  cat << EOT

  Usage: ${0} [OPTION...] FILE

  Help options:
    -H Show this help message
    -U Display brief usage
    -V Print version

EOT
  functions::exit "${exit_code}"
}

#######################################
# Print the given file with its line endings converted to DOS (CRLF).
#
# Notes:
#   - exits from shell with -H, -U, -V, an unknown option or an unreadable file.
#
# Globals:
#   HOME
#   OPTIND
# Arguments:
#   None
# Outputs:
#   The converted file, or the version with -V, to stdout.
# Returns:
#   None
#######################################
main() {
  # shellcheck source=../etc/bash44.shconf
  . "$(dirname "${0}")"/../etc/bash44.shconf || exit 1
  # shellcheck source=../etc/constants.shconf
  . "$(dirname "${0}")"/../etc/constants.shconf
  # shellcheck source=../etc/functions.shconf
  . "$(dirname "${0}")"/../etc/functions.shconf
  # local variables
  #
  local getopts_args
  local getopts_version
  getopts_args=''
  getopts_version='v20261024'
  trap 'functions::catch_all ${?}' ERR
  trap 'functions::catch_all 129 SIGHUP' SIGHUP
  trap 'functions::catch_all 130 SIGINT' SIGINT
  trap 'functions::catch_all 131 SIGQUIT' SIGQUIT
  trap 'functions::catch_all 143 SIGTERM' SIGTERM
  # getopts
  #
  OPTIND=1
  while getopts 'HUV' getopts_args; do
    case "${getopts_args}" in
      H | U)
        this::help 0
        ;;
      V)
        functions::exit 0 "${getopts_version}"
        ;;
      *)
        this::help 1
        ;;
    esac
  done
  shift $((OPTIND - 1))
  # main
  #
  [ $# -ge 1 ] || this::help 1
  if [ -r "${1:?}" ]; then
    perl -e 's/\r\n|\n|\r/\r\n/g' -p "${1:?}"
  else
    functions::exit 1 "'${1:?}' was NOT readable, exiting."
  fi
}

# main (bats)
#
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  main "${@}"
fi
