# shellcheck shell=bash
#
# index:
#   - functions::catch_all
#   - functions::exit
#   - functions::log_to_stderr
#   - functions::log_to_stdout
#   - functions::print_to_stderr
#   - functions::print_to_stderr_decorated
#   - functions::print_to_stdout
#   - functions::print_to_stdout_decorated
#   - functions::stderr
#   - functions::stdout
#

#######################################
# Reset the traps, report the caught signal or the failing line, and exit with the given code.
#
# Notes:
#   - exits from shell.
#
# Arguments:
#   1: exit code (required, integer)
#   2: signal name (optional, string)
# Outputs:
#   The caught signal, or the exit code and failing line, to stderr, when the exit code is not 0.
# Returns:
#   None
#######################################
functions::catch_all() {
  local exit_code
  local signal
  exit_code="${1:?}"
  signal="${2:-}"
  trap - ERR SIGHUP SIGINT SIGQUIT SIGTERM
  if [[ ${exit_code} == 0 ]]; then
    :
  elif [ -n "${signal}" ]; then
    printf '%s\n' "*** ${signal} caught ***" >&2
  else
    printf '%s\n' "*** exit code << ${exit_code} >> on line $(caller) ***" >&2
  fi
  exit "${exit_code}"
}

#######################################
# Print the optional message and exit from shell with the given exit code, or 1 when it is not numeric.
# Arguments:
#   1 - exit code (optional, integer, defaults to '1')
#   2 - message (optional, string)
# Outputs:
#   The message, when given, to stdout.
# Returns:
#   None
#######################################
functions::exit() {
  local exit_code
  local message
  exit_code="${1:-1}"
  message="${2:-}"
  if [ -n "${message}" ]; then
    printf '%s\n' "${message}"
  fi
  if [[ ${exit_code} =~ ^[0-9]+$ ]]; then
    exit "${exit_code}"
  else
    exit 1
  fi
}

#######################################
# Print the message prefixed with the current date to stderr.
# Arguments:
#   * - message (required, string)
# Outputs:
#   Message with date to stderr.
# Returns:
#   None
#######################################
functions::log_to_stderr() {
  local date
  local message
  date="$(coreutils date --rfc-3339=seconds 2> /dev/null || date --rfc-3339=seconds 2> /dev/null || printf '%s' '1970-01-01 00:00:00+00:00')"
  message="${*:?}"
  printf '%s\n' "[${date}] ${message}" >&2
}

#######################################
# Print the message prefixed with the current date to stdout.
# Arguments:
#   * - message (required, string)
# Outputs:
#   Message with date to stdout.
# Returns:
#   None
#######################################
functions::log_to_stdout() {
  local date
  local message
  date="$(coreutils date --rfc-3339=seconds 2> /dev/null || date --rfc-3339=seconds 2> /dev/null || printf '%s' '1970-01-01 00:00:00+00:00')"
  message="${*:?}"
  printf '%s\n' "[${date}] ${message}"
}

#######################################
# Print the message to stderr.
# Arguments:
#   * - message (optional, string)
# Outputs:
#   Message to stderr.
# Returns:
#   None
#######################################
functions::print_to_stderr() {
  local message
  message="${*:-}"
  printf '%s\n' "${message}" >&2
}

#######################################
# Print the message framed by the decoration character to stderr.
# Globals:
#   DECORATION_CHARACTER
# Arguments:
#   * - message (required, string)
# Outputs:
#   Message to stderr (decorated).
# Returns:
#   None
#######################################
functions::print_to_stderr_decorated() {
  local decoration_character
  local message
  decoration_character="${DECORATION_CHARACTER:-#}"
  message="${*:?}"
  printf '\n' >&2
  printf "%$((${#message} + 4))s\n" | tr ' ' "${decoration_character:0:1}" >&2
  printf '%s\n' "${decoration_character:0:1} ${message} ${decoration_character:0:1}" >&2
  printf "%$((${#message} + 4))s\n" | tr ' ' "${decoration_character:0:1}" >&2
  printf '\n' >&2
}

#######################################
# Print the message to stdout.
# Arguments:
#   * - message (optional, string)
# Outputs:
#   Message to stdout.
# Returns:
#   None
#######################################
functions::print_to_stdout() {
  local message
  message="${*:-}"
  printf '%s\n' "${message}"
}

#######################################
# Print the message framed by the decoration character to stdout.
# Globals:
#   DECORATION_CHARACTER
# Arguments:
#   * - message (required, string)
# Outputs:
#   Message to stdout (decorated).
# Returns:
#   None
#######################################
functions::print_to_stdout_decorated() {
  local decoration_character
  local message
  decoration_character="${DECORATION_CHARACTER:-#}"
  message="${*:?}"
  printf '\n'
  printf "%$((${#message} + 4))s\n" | tr ' ' "${decoration_character:0:1}"
  printf '%s\n' "${decoration_character:0:1} ${message} ${decoration_character:0:1}"
  printf "%$((${#message} + 4))s\n" | tr ' ' "${decoration_character:0:1}"
  printf '\n'
}

#######################################
# Alias to functions::print_to_stderr.
# Arguments:
#   * - message (optional, string)
# Outputs:
#   Message to stderr.
# Returns:
#   None
#######################################
functions::stderr() {
  functions::print_to_stderr "${*:-}"
}

#######################################
# Alias to functions::print_to_stdout.
# Arguments:
#   * - message (optional, string)
# Outputs:
#   Message to stdout.
# Returns:
#   None
#######################################
functions::stdout() {
  functions::print_to_stdout "${*:-}"
}
